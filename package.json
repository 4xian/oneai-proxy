{
  "name": "oneai-proxy-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5188",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config .oxlintrc.json web/src vite.config.ts",
    "lint:fix": "oxlint --config .oxlintrc.json --fix web/src vite.config.ts",
    "format": "oxfmt --config .oxfmtrc.json --write web/src package.json tsconfig.json vite.config.ts web/index.html",
    "format:check": "oxfmt --config .oxfmtrc.json --check web/src package.json tsconfig.json vite.config.ts web/index.html",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "dependencies": {
    "@douyinfe/semi-ui-19": "2.102.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
